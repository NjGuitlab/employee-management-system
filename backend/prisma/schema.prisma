// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Employe
}

enum StatutEmploye {
  Actif
  Inactif
}

enum StatutConge {
  EnAttente
  Approuve
  Refuse
}

model Utilisateur {
  id            String    @id @default(uuid())
  email         String    @unique
  motDePasse    String
  nom           String
  prenom        String
  role          Role      @default(Employe)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

}

model Departement {

  id              Int         @id @default(autoincrement())
  nom             String      @unique
  description     String?
  employes        Employe[]   
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Poste {

  id          Int             @id  @default(autoincrement())
  nom         String          @unique
  description String?
  employes    Employe[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

}


model Evaluation {

  id             Int        @id @default(autoincrement())

  dateEvaluation DateTime   @db.Date

  note           Int

  commentaire    String?

  employeId      Int

  employe        Employe    @relation(fields: [employeId], references: [id])

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

}


model Conge {

  id            Int           @id @default(autoincrement())

  dateDebut     DateTime      @db.Date

  dateFin       DateTime      @db.Date

  motif         String?

  statut        StatutConge   @default(EnAttente)

  employeId     Int

  employe       Employe       @relation(fields: [employeId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

}

model Employe {
  id               Int              @id @default(autoincrement())

  nom              String
  prenom           String

  emailPro         String           @unique
  telephone        String?

  posteId          Int 
  departementId    Int
  salaire          Decimal?

  photo            String?

  dateEmbauche     DateTime         @db.Date
  statut           StatutEmploye    @default(Actif)

  evaluations      Evaluation[]
  conges           Conge[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  poste            Poste            @relation(fields:[posteId], references:[id])
  departement      Departement      @relation(fields:[departementId], references:[id])

}
